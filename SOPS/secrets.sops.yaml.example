# Example plaintext Ansible group_vars secrets file, the state BEFORE
# encryption. Copy to <repo>/ansible/group_vars/<group>/secrets.sops.yaml.
#
# The better move is to never have a plaintext copy at all. On a path that
# does not exist yet, sops reports that it is creating the file, generates
# the data key, and opens $SOPS_EDITOR or $EDITOR on a template:
#
#   cd <repo>
#   sops edit ansible/group_vars/load_balancers/secrets.sops.yaml
#
# To encrypt a file that already exists, in place:
#
#   sops encrypt -i ansible/group_vars/load_balancers/secrets.sops.yaml
#
# The name has to end in .sops.yaml, .sops.yml or .sops.json. That is what
# the community.sops.sops vars plugin looks for and what the creation rule in
# .sops.yaml matches. Hidden files are ignored by the plugin.
#
# SOPS encrypts comments too, so delete this header before encrypting.
#
# Top-level keys become Ansible variable names and stay readable. The values
# are what get encrypted.
#
# After encrypting:
#   sops filestatus <file>                     # {"encrypted":true}
#   grep -cE 'recipient:[[:space:]]*age1' <file>
#   git check-ignore -q <file>; echo $?        # expect 1

keepalived_auth_pass: replace-me
